# Prefer Secrets Manager for API keys; keep model / AWS / S3 config here.

SECRETS_MANAGER_SECRET_ID=deep-research-agent/dev

# Local fallback (optional if Secrets Manager is set)
# TAVILY_API_KEY=
# GOOGLE_API_KEY=

# Shared secret for the HTTP API (X-API-Key header); prefer Secrets Manager
# RESEARCH_API_KEY=

MODEL=google_genai:gemini-3.5-flash-lite
# MODEL=google_genai:gemini-3.5-flash
# MODEL=groq:llama-3.3-70b-versatile

# AWS (credentials via env or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET=deep-research-agent-139675292967-eu-north-1-an
JOBS_TABLE=deep-research-jobs
JOBS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/139675292967/deep-research-jobs
STATE_MACHINE_ARN=arn:aws:states:eu-north-1:139675292967:stateMachine:deep-research-enqueue
EVENT_BUS_NAME=deep-research
