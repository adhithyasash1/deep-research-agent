{
  "family": "deep-research-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::139675292967:role/deep-research-ecs-execution",
  "taskRoleArn": "arn:aws:iam::139675292967:role/deep-research-ecs-task",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "139675292967.dkr.ecr.eu-north-1.amazonaws.com/deep-research-agent:v4",
      "essential": true,
      "command": ["src.worker", "--secrets-overwrite"],
      "environment": [
        { "name": "AWS_REGION", "value": "eu-north-1" },
        { "name": "AWS_DEFAULT_REGION", "value": "eu-north-1" },
        { "name": "S3_BUCKET", "value": "deep-research-agent-139675292967-eu-north-1-an" },
        { "name": "SECRETS_MANAGER_SECRET_ID", "value": "deep-research-agent/dev" },
        { "name": "MODEL", "value": "google_genai:gemini-3.5-flash-lite" },
        { "name": "JOBS_TABLE", "value": "deep-research-jobs" },
        {
          "name": "JOBS_QUEUE_URL",
          "value": "https://sqs.eu-north-1.amazonaws.com/139675292967/deep-research-jobs"
        },
        { "name": "EVENT_BUS_NAME", "value": "deep-research" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/deep-research-worker",
          "awslogs-region": "eu-north-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
